# Copy to .env and adjust. Read at startup (node --env-file-if-exists).

# Local model (MLX). MyHub runs `<python> -m mlx_lm server` on demand — no venv activation needed.
# Use the python inside the venv that has mlx_lm installed.
LOCAL_MODEL_PYTHON=/Users/YOU/Personal/MeExp/MyAi/.venv/bin/python
LOCAL_MODEL=mlx-community/Qwen3.5-9B-MLX-4bit
LOCAL_MODEL_PORT=8080
LOCAL_MODEL_MAX_TOKENS=1024
# true = let the model "think" before answering (slower, sometimes better)
LOCAL_MODEL_THINKING=false

# Optional: put the data somewhere else
# HUB_DATA_DIR=/path/to/PersonalContextHubData
